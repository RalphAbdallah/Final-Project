# Copy to .env and fill in from your Supabase project. Check it with: npm run db:check
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Receipt-reading limits (see backend/src/receipts/limits.js)
AI_READS_PER_HOUR=3
AI_READS_PER_DAY=10
AI_USER_TOKENS_PER_DAY=150000
AI_GLOBAL_TOKENS_PER_DAY=250000
# Join and claim rate limits (see backend/src/rateLimits.js). RATE_LIMITS=off turns them off (local only).
RATE_JOIN_PER_BILL=20
RATE_JOIN_PER_ADDRESS=30
RATE_CLAIM_PER_PERSON=60
RATE_CLAIM_PER_ADDRESS=300
# Proxy hops to trust for the phone's address (1 on Render by default; 'false' locally)
# TRUST_PROXY=1
