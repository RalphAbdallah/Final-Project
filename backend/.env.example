# Copy to .env and fill in from your Supabase project. Check it with: npm run db:check
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Receipt-reading limits (see backend/src/receipts/limits.js)
AI_READS_PER_HOUR=10
AI_READS_PER_DAY=30
AI_USER_TOKENS_PER_DAY=150000
AI_GLOBAL_TOKENS_PER_DAY=2000000
