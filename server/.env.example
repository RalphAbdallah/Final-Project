# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# MongoDB Atlas connection string (Session 18): cluster -> Connect -> Drivers
MONGODB_URI=
# Long random secret for signing login tokens. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# The front end's address (several: separate with commas)
CLIENT_ORIGIN=http://localhost:5173
PORT=3000

# Receipt reading (OpenAI). Empty = reading photos is off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Receipt-reading limits (services/aiLimits.js). AI_LIMITS=off turns them off (local only).
AI_READS_PER_HOUR=3
AI_READS_PER_DAY=10
AI_USER_TOKENS_PER_DAY=150000
AI_GLOBAL_TOKENS_PER_DAY=250000

# Join and claim limits (middleware/rateLimits.js). RATE_LIMITS=off turns them off (local only).
RATE_JOIN_PER_BILL=20
RATE_JOIN_PER_ADDRESS=30
RATE_CLAIM_PER_PERSON=60
RATE_CLAIM_PER_ADDRESS=300
